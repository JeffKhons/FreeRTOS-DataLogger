 376:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****          * cannot be masked using BASEPRI.
 377:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****          * See https://www.FreeRTOS.org/RTOS-Cortex-M3-M4.html */
 378:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****         configASSERT( ucMaxSysCallPriority );
