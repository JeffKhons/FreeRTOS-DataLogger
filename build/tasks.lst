 354:FreeRTOS/src/tasks.c ****         if( ( xCoreID ) == ( BaseType_t ) portGET_CORE_ID() )                                \
 355:FreeRTOS/src/tasks.c ****         {                                                                                    \
 356:FreeRTOS/src/tasks.c ****             /* Pending a yield for this core since it is in the critical section. */         \
 357:FreeRTOS/src/tasks.c ****             xYieldPendings[ ( xCoreID ) ] = pdTRUE;                                          \
 358:FreeRTOS/src/tasks.c ****         }                                                                                    \
 359:FreeRTOS/src/tasks.c ****         else                                                                                 \
 360:FreeRTOS/src/tasks.c ****         {                                                                                    \
 361:FreeRTOS/src/tasks.c ****             /* Request other core to yield if it is not requested before. */                 \
 362:FreeRTOS/src/tasks.c ****             if( pxCurrentTCBs[ ( xCoreID ) ]->xTaskRunState != taskTASK_SCHEDULED_TO_YIELD ) \
 363:FreeRTOS/src/tasks.c ****             {                                                                                \
 364:FreeRTOS/src/tasks.c ****                 portYIELD_CORE( xCoreID );                                                   \
 365:FreeRTOS/src/tasks.c ****                 pxCurrentTCBs[ ( xCoreID ) ]->xTaskRunState = taskTASK_SCHEDULED_TO_YIELD;   \
 366:FreeRTOS/src/tasks.c ****             }                                                                                \
 367:FreeRTOS/src/tasks.c ****         }                                                                                    \
 368:FreeRTOS/src/tasks.c ****     } while( 0 )
