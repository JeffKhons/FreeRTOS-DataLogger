 181:FreeRTOS/portable/MemMang/heap_4.c **** 
 182:FreeRTOS/portable/MemMang/heap_4.c ****     if( xWantedSize > 0 )
 183:FreeRTOS/portable/MemMang/heap_4.c ****     {
 184:FreeRTOS/portable/MemMang/heap_4.c ****         /* The wanted size must be increased so it can contain a BlockLink_t
 185:FreeRTOS/portable/MemMang/heap_4.c ****          * structure in addition to the requested amount of bytes. */
 186:FreeRTOS/portable/MemMang/heap_4.c ****         if( heapADD_WILL_OVERFLOW( xWantedSize, xHeapStructSize ) == 0 )
 187:FreeRTOS/portable/MemMang/heap_4.c ****         {
 188:FreeRTOS/portable/MemMang/heap_4.c ****             xWantedSize += xHeapStructSize;
 189:FreeRTOS/portable/MemMang/heap_4.c **** 
 190:FreeRTOS/portable/MemMang/heap_4.c ****             /* Ensure that blocks are always aligned to the required number
 191:FreeRTOS/portable/MemMang/heap_4.c ****              * of bytes. */
 192:FreeRTOS/portable/MemMang/heap_4.c ****             if( ( xWantedSize & portBYTE_ALIGNMENT_MASK ) != 0x00 )
 193:FreeRTOS/portable/MemMang/heap_4.c ****             {
 194:FreeRTOS/portable/MemMang/heap_4.c ****                 /* Byte alignment required. */
 195:FreeRTOS/portable/MemMang/heap_4.c ****                 xAdditionalRequiredSize = portBYTE_ALIGNMENT - ( xWantedSize & portBYTE_ALIGNMENT_M
 196:FreeRTOS/portable/MemMang/heap_4.c **** 
 197:FreeRTOS/portable/MemMang/heap_4.c ****                 if( heapADD_WILL_OVERFLOW( xWantedSize, xAdditionalRequiredSize ) == 0 )
 198:FreeRTOS/portable/MemMang/heap_4.c ****                 {
 199:FreeRTOS/portable/MemMang/heap_4.c ****                     xWantedSize += xAdditionalRequiredSize;
 200:FreeRTOS/portable/MemMang/heap_4.c ****                 }
 201:FreeRTOS/portable/MemMang/heap_4.c ****                 else
