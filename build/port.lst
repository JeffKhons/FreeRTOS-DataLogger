 313:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****     /* An application can install FreeRTOS interrupt handlers in one of the
 314:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****      * following ways:
 315:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****      * 1. Direct Routing - Install the functions vPortSVCHandler and
 316:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****      *    xPortPendSVHandler for SVCall and PendSV interrupts respectively.
 317:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****      * 2. Indirect Routing - Install separate handlers for SVCall and PendSV
 318:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****      *    interrupts and route program control from those handlers to
 319:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****      *    vPortSVCHandler and xPortPendSVHandler functions.
 320:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****      *
 321:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****      * Applications that use Indirect Routing must set
 322:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****      * configCHECK_HANDLER_INSTALLATION to 0 in their FreeRTOSConfig.h. Direct
 323:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****      * routing, which is validated here when configCHECK_HANDLER_INSTALLATION
 324:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****      * is 1, should be preferred when possible. */
 325:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****     #if ( configCHECK_HANDLER_INSTALLATION == 1 )
 326:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****     {
 327:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****         const portISR_t * const pxVectorTable = portSCB_VTOR_REG;
 328:FreeRTOS/portable/GCC/ARM_CM4F/port.c **** 
 329:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****         /* Validate that the application has correctly installed the FreeRTOS
 330:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****          * handlers for SVCall and PendSV interrupts. We do not check the
 331:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****          * installation of the SysTick handler because the application may
 332:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****          * choose to drive the RTOS tick using a timer other than the SysTick
 333:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****          * timer by overriding the weak function vPortSetupTimerInterrupt().
 334:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****          *
 335:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****          * Assertion failures here indicate incorrect installation of the
 336:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****          * FreeRTOS handlers. For help installing the FreeRTOS handlers, see
 337:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****          * https://www.freertos.org/Why-FreeRTOS/FAQs.
 338:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****          *
 339:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****          * Systems with a configurable address for the interrupt vector table
 340:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****          * can also encounter assertion failures or even system faults here if
 341:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****          * VTOR is not set correctly to point to the application's vector table. */
 342:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****         configASSERT( pxVectorTable[ portVECTOR_INDEX_SVC ] == vPortSVCHandler );
 343:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****         configASSERT( pxVectorTable[ portVECTOR_INDEX_PENDSV ] == xPortPendSVHandler );
 344:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****     }
 345:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****     #endif /* configCHECK_HANDLER_INSTALLATION */
 346:FreeRTOS/portable/GCC/ARM_CM4F/port.c **** 
