 122:FreeRTOS/portable/MemMang/heap_4.c **** /* Macro to load/store BlockLink_t pointers to memory. By XORing the
 123:FreeRTOS/portable/MemMang/heap_4.c ****  * pointers with a random canary value, heap overflows will result
 124:FreeRTOS/portable/MemMang/heap_4.c ****  * in randomly unpredictable pointer values which will be caught by
 125:FreeRTOS/portable/MemMang/heap_4.c ****  * heapVALIDATE_BLOCK_POINTER assert. */
 126:FreeRTOS/portable/MemMang/heap_4.c ****     #define heapPROTECT_BLOCK_POINTER( pxBlock )    ( ( BlockLink_t * ) ( ( ( portPOINTER_SIZE_TYPE
 127:FreeRTOS/portable/MemMang/heap_4.c **** #else
 128:FreeRTOS/portable/MemMang/heap_4.c **** 
 129:FreeRTOS/portable/MemMang/heap_4.c ****     #define heapPROTECT_BLOCK_POINTER( pxBlock )    ( pxBlock )
 130:FreeRTOS/portable/MemMang/heap_4.c **** 
 131:FreeRTOS/portable/MemMang/heap_4.c **** #endif /* configENABLE_HEAP_PROTECTOR */
 132:FreeRTOS/portable/MemMang/heap_4.c **** 
 133:FreeRTOS/portable/MemMang/heap_4.c **** /* Assert that a heap block pointer is within the heap bounds. */
 134:FreeRTOS/portable/MemMang/heap_4.c **** #define heapVALIDATE_BLOCK_POINTER( pxBlock )                          \
 135:FreeRTOS/portable/MemMang/heap_4.c ****     configASSERT( ( ( uint8_t * ) ( pxBlock ) >= &( ucHeap[ 0 ] ) ) && \
 136:FreeRTOS/portable/MemMang/heap_4.c ****                   ( ( uint8_t * ) ( pxBlock ) <= &( ucHeap[ configTOTAL_HEAP_SIZE - 1 ] ) ) )
 137:FreeRTOS/portable/MemMang/heap_4.c **** 
