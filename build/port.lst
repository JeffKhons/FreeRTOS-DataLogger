 384:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****         /* Calculate the maximum acceptable priority group value for the number
 385:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****          * of bits read back. */
 386:FreeRTOS/portable/GCC/ARM_CM4F/port.c **** 
 387:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****         while( ( ucMaxPriorityValue & portTOP_BIT_OF_BYTE ) == portTOP_BIT_OF_BYTE )
 388:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****         {
