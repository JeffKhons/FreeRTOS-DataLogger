 173:FreeRTOS/portable/MemMang/heap_4.c **** void * pvPortMalloc( size_t xWantedSize )
 174:FreeRTOS/portable/MemMang/heap_4.c **** {
 175:FreeRTOS/portable/MemMang/heap_4.c ****     BlockLink_t * pxBlock;
 176:FreeRTOS/portable/MemMang/heap_4.c ****     BlockLink_t * pxPreviousBlock;
 177:FreeRTOS/portable/MemMang/heap_4.c ****     BlockLink_t * pxNewBlockLink;
