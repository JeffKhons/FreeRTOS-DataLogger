  41:bsp/Src/bsp_w25q64.c **** /**
  42:bsp/Src/bsp_w25q64.c ****  * @brief  解除晶片防寫保護 (Write Status Register)
  43:bsp/Src/bsp_w25q64.c ****  * @note   將狀態暫存器清零，解除可能存在的 Block Protect
  44:bsp/Src/bsp_w25q64.c ****  */
  45:bsp/Src/bsp_w25q64.c **** void W25Q_Unprotect(void) {
  46:bsp/Src/bsp_w25q64.c ****     W25Q_WriteEnable();
  47:bsp/Src/bsp_w25q64.c ****     W25Q_CS_LOW();
  48:bsp/Src/bsp_w25q64.c ****     SPI1_TxRxByte(0x01); // 寫入狀態暫存器指令
  49:bsp/Src/bsp_w25q64.c ****     SPI1_TxRxByte(0x00); // 寫入 SR1 (清除所有保護)
  50:bsp/Src/bsp_w25q64.c ****     SPI1_TxRxByte(0x00); // 寫入 SR2
  51:bsp/Src/bsp_w25q64.c ****     W25Q_CS_HIGH();
  52:bsp/Src/bsp_w25q64.c ****     W25Q_WaitForReady();
  53:bsp/Src/bsp_w25q64.c **** }
  54:bsp/Src/bsp_w25q64.c **** 
  55:bsp/Src/bsp_w25q64.c **** /**
  56:bsp/Src/bsp_w25q64.c ****  * @brief  擦除指定的 4KB 磁區 (Sector Erase)
  57:bsp/Src/bsp_w25q64.c ****  * @note   Flash 的物理特性必須先擦除為 0xFF 才能寫入新資料
  58:bsp/Src/bsp_w25q64.c ****  */
  59:bsp/Src/bsp_w25q64.c **** void W25Q_SectorErase(uint32_t sector_addr) {
  60:bsp/Src/bsp_w25q64.c ****     W25Q_WriteEnable(); 
  61:bsp/Src/bsp_w25q64.c ****     W25Q_CS_LOW();
  62:bsp/Src/bsp_w25q64.c ****     SPI1_TxRxByte(0x20); 
  63:bsp/Src/bsp_w25q64.c ****     SPI1_TxRxByte((sector_addr >> 16) & 0xFF);
  64:bsp/Src/bsp_w25q64.c ****     SPI1_TxRxByte((sector_addr >> 8) & 0xFF);
  65:bsp/Src/bsp_w25q64.c ****     SPI1_TxRxByte(sector_addr & 0xFF);
  66:bsp/Src/bsp_w25q64.c ****     W25Q_CS_HIGH();
  67:bsp/Src/bsp_w25q64.c ****     W25Q_WaitForReady(); 
  68:bsp/Src/bsp_w25q64.c **** }
  69:bsp/Src/bsp_w25q64.c **** 
  70:bsp/Src/bsp_w25q64.c **** /**
  71:bsp/Src/bsp_w25q64.c ****  * @brief  將 32-bit 資料寫入 Flash
  72:bsp/Src/bsp_w25q64.c ****  * @note   將 4 Bytes 的資料依序寫入指定位址 (Page Program)
  73:bsp/Src/bsp_w25q64.c ****  */
  74:bsp/Src/bsp_w25q64.c **** void W25Q_WriteInt32(uint32_t addr, int32_t data) {
  75:bsp/Src/bsp_w25q64.c ****     W25Q_WriteEnable(); 
  76:bsp/Src/bsp_w25q64.c ****     W25Q_CS_LOW();
  77:bsp/Src/bsp_w25q64.c ****     SPI1_TxRxByte(0x02); 
  78:bsp/Src/bsp_w25q64.c ****     SPI1_TxRxByte((addr >> 16) & 0xFF);
  79:bsp/Src/bsp_w25q64.c ****     SPI1_TxRxByte((addr >> 8) & 0xFF);
  80:bsp/Src/bsp_w25q64.c ****     SPI1_TxRxByte(addr & 0xFF);
  81:bsp/Src/bsp_w25q64.c ****     
  82:bsp/Src/bsp_w25q64.c ****     SPI1_TxRxByte((data >> 24) & 0xFF);
  83:bsp/Src/bsp_w25q64.c ****     SPI1_TxRxByte((data >> 16) & 0xFF);
  84:bsp/Src/bsp_w25q64.c ****     SPI1_TxRxByte((data >> 8) & 0xFF);
  85:bsp/Src/bsp_w25q64.c ****     SPI1_TxRxByte(data & 0xFF);
  86:bsp/Src/bsp_w25q64.c ****     W25Q_CS_HIGH();
  87:bsp/Src/bsp_w25q64.c ****     W25Q_WaitForReady(); 
  88:bsp/Src/bsp_w25q64.c **** }
ARM GAS  C:\Users\user\AppData\Local\Temp\ccEpklN9.s 			page 3


  89:bsp/Src/bsp_w25q64.c **** 
  90:bsp/Src/bsp_w25q64.c **** /**
  91:bsp/Src/bsp_w25q64.c ****  * @brief  從 Flash 讀取 32-bit 資料
  92:bsp/Src/bsp_w25q64.c ****  */
  93:bsp/Src/bsp_w25q64.c **** int32_t W25Q_ReadInt32(uint32_t addr) {
  94:bsp/Src/bsp_w25q64.c ****     int32_t data = 0;
  95:bsp/Src/bsp_w25q64.c ****     W25Q_CS_LOW();
  96:bsp/Src/bsp_w25q64.c ****     SPI1_TxRxByte(0x03); 
  97:bsp/Src/bsp_w25q64.c ****     SPI1_TxRxByte((addr >> 16) & 0xFF);
  98:bsp/Src/bsp_w25q64.c ****     SPI1_TxRxByte((addr >> 8) & 0xFF);
  99:bsp/Src/bsp_w25q64.c ****     SPI1_TxRxByte(addr & 0xFF);
 100:bsp/Src/bsp_w25q64.c ****     
 101:bsp/Src/bsp_w25q64.c ****     // 強制轉型，防止 0xFF 位移造成符號異常擴展
 102:bsp/Src/bsp_w25q64.c ****     data |= ((uint32_t)SPI1_TxRxByte(0xFF) << 24);
 103:bsp/Src/bsp_w25q64.c ****     data |= ((uint32_t)SPI1_TxRxByte(0xFF) << 16);
 104:bsp/Src/bsp_w25q64.c ****     data |= ((uint32_t)SPI1_TxRxByte(0xFF) << 8);
 105:bsp/Src/bsp_w25q64.c ****     data |= ((uint32_t)SPI1_TxRxByte(0xFF));
 106:bsp/Src/bsp_w25q64.c ****     W25Q_CS_HIGH();
 107:bsp/Src/bsp_w25q64.c ****     return data;
 108:bsp/Src/bsp_w25q64.c **** }
 109:bsp/Src/bsp_w25q64.c **** 
 110:bsp/Src/bsp_w25q64.c **** /**
 111:bsp/Src/bsp_w25q64.c ****  * @brief  開機 SPI 傳輸與寫入完整性測試
 112:bsp/Src/bsp_w25q64.c ****  * @note   在最後一個 Sector (0x7FF000) 寫入測試特徵碼並讀回驗證
 113:bsp/Src/bsp_w25q64.c ****  */
 114:bsp/Src/bsp_w25q64.c **** bool W25Q_SelfTest(void) {
 115:bsp/Src/bsp_w25q64.c ****     const uint32_t test_addr = 0x7FF000;
 116:bsp/Src/bsp_w25q64.c ****     const int32_t test_pattern = 0x55AA1234;
 117:bsp/Src/bsp_w25q64.c ****     
 118:bsp/Src/bsp_w25q64.c ****     W25Q_SectorErase(test_addr);
 119:bsp/Src/bsp_w25q64.c ****     W25Q_WriteInt32(test_addr, test_pattern);
 120:bsp/Src/bsp_w25q64.c ****     int32_t read_back = W25Q_ReadInt32(test_addr);
 121:bsp/Src/bsp_w25q64.c ****     
 122:bsp/Src/bsp_w25q64.c ****     return (read_back == test_pattern);
 123:bsp/Src/bsp_w25q64.c **** }
 124:bsp/Src/bsp_w25q64.c **** 
 125:bsp/Src/bsp_w25q64.c **** /**
 126:bsp/Src/bsp_w25q64.c ****  * @brief  利用二元搜尋 (Binary Search) 快速尋找 Flash 斷電前的紀錄筆數
 127:bsp/Src/bsp_w25q64.c ****  * @note   8MB 空間約可存 209 萬筆，二元搜尋最多僅需讀取 21 次，時間複雜度
 128:bsp/Src/bsp_w25q64.c ****  */
 129:bsp/Src/bsp_w25q64.c **** uint32_t W25Q_ScanBootCount(void) {
 130:bsp/Src/bsp_w25q64.c ****     uint32_t low = 0;
 131:bsp/Src/bsp_w25q64.c ****     // 扣除掉最後一個用來做 Self-Test 的 Sector (0x7FF000)，最大筆數約 2,096,127
 132:bsp/Src/bsp_w25q64.c ****     uint32_t high = (0x7FF000 / 4) - 1; 
 133:bsp/Src/bsp_w25q64.c ****     uint32_t result = 0; // 如果整個 Flash 都是空的，預設回傳 0
 134:bsp/Src/bsp_w25q64.c **** 
 135:bsp/Src/bsp_w25q64.c ****     // 邊界防禦：如果第 0 筆就是空的 (-1 代表 0xFFFFFFFF)，直接回傳 0，省下�
 136:bsp/Src/bsp_w25q64.c ****     if ((uint32_t)W25Q_ReadInt32(0) == 0xFFFFFFFF) {
 137:bsp/Src/bsp_w25q64.c ****         return 0;
 138:bsp/Src/bsp_w25q64.c ****     }
 139:bsp/Src/bsp_w25q64.c **** 
 140:bsp/Src/bsp_w25q64.c ****     // 開始二元搜尋邊界
 141:bsp/Src/bsp_w25q64.c ****     while (low <= high) {
 142:bsp/Src/bsp_w25q64.c ****         uint32_t mid = low + (high - low) / 2;
 143:bsp/Src/bsp_w25q64.c ****         uint32_t data = (uint32_t)W25Q_ReadInt32(mid * 4);
 144:bsp/Src/bsp_w25q64.c **** 
 145:bsp/Src/bsp_w25q64.c ****         if (data == 0xFFFFFFFF) { 
ARM GAS  C:\Users\user\AppData\Local\Temp\ccEpklN9.s 			page 4


 146:bsp/Src/bsp_w25q64.c ****             // 讀到 0xFFFFFFFF (空)，代表我們要找的邊界在「左半邊」
 147:bsp/Src/bsp_w25q64.c ****             if (mid == 0) break; // 防止下溢位
 148:bsp/Src/bsp_w25q64.c ****             high = mid - 1;
 149:bsp/Src/bsp_w25q64.c ****         } else {
 150:bsp/Src/bsp_w25q64.c ****             // 讀到有資料，代表我們要找的邊界還在「右半邊」
 151:bsp/Src/bsp_w25q64.c ****             result = mid + 1; // 紀錄目前已知的最右側有資料的位置 + 1
 152:bsp/Src/bsp_w25q64.c ****             low = mid + 1;
 153:bsp/Src/bsp_w25q64.c ****         }
 154:bsp/Src/bsp_w25q64.c ****     }
 155:bsp/Src/bsp_w25q64.c ****     return result; // 回傳找到的下一筆空白位置索引
 156:bsp/Src/bsp_w25q64.c **** }
