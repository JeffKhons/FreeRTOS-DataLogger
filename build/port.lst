 407:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****              * to 4, this confusion does not happen and the behaviour remains the same.
 408:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****              *
 409:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****              * The following assert ensures that the sub-priority bit in the
 410:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****              * configMAX_SYSCALL_INTERRUPT_PRIORITY is clear to avoid the above mentioned
 411:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****              * confusion. */
 412:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****             configASSERT( ( configMAX_SYSCALL_INTERRUPT_PRIORITY & 0x1U ) == 0U );
