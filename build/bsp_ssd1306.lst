  97:bsp/Src/bsp_ssd1306.c **** /**
  98:bsp/Src/bsp_ssd1306.c ****  * @brief  初始化 SSD1306 螢幕
  99:bsp/Src/bsp_ssd1306.c ****  * @note   包含開啟電荷幫浦、設定對比度、關閉全白顯示等標準流程
 100:bsp/Src/bsp_ssd1306.c ****  */
 101:bsp/Src/bsp_ssd1306.c **** void OLED_Init(void) {
 102:bsp/Src/bsp_ssd1306.c ****     // 等待硬體上電穩定
 103:bsp/Src/bsp_ssd1306.c ****     for(volatile int i=0; i<50000; i++); 
 104:bsp/Src/bsp_ssd1306.c **** 
 105:bsp/Src/bsp_ssd1306.c ****     OLED_WriteCommand(0xAE); // 關閉螢幕 (Display OFF)
 106:bsp/Src/bsp_ssd1306.c ****     OLED_WriteCommand(0x20); // 設定記憶體尋址模式
 107:bsp/Src/bsp_ssd1306.c ****     OLED_WriteCommand(0x10); // 00: 水平, 01: 垂直, 10: 分頁 (Page Addressing)
 108:bsp/Src/bsp_ssd1306.c ****     OLED_WriteCommand(0xB0); // 設定 Page Start Address
 109:bsp/Src/bsp_ssd1306.c ****     OLED_WriteCommand(0xC8); // COM 輸出掃描方向 (上下反轉)
 110:bsp/Src/bsp_ssd1306.c ****     OLED_WriteCommand(0x00); // 設定 Low Column Address
 111:bsp/Src/bsp_ssd1306.c ****     OLED_WriteCommand(0x10); // 設定 High Column Address
ARM GAS  C:\Users\user\AppData\Local\Temp\ccF5Dc0e.s 			page 5


 112:bsp/Src/bsp_ssd1306.c ****     OLED_WriteCommand(0x40); // 設定 Start Line Address
 113:bsp/Src/bsp_ssd1306.c ****     OLED_WriteCommand(0x81); // 設定對比度控制
 114:bsp/Src/bsp_ssd1306.c ****     OLED_WriteCommand(0xFF); // 亮度全開 (0x00~0xFF)
 115:bsp/Src/bsp_ssd1306.c ****     OLED_WriteCommand(0xA1); // 設定 Segment Re-map (左右反轉)
 116:bsp/Src/bsp_ssd1306.c ****     OLED_WriteCommand(0xA6); // 正常顯示 (非反白)
 117:bsp/Src/bsp_ssd1306.c ****     OLED_WriteCommand(0xA8); // 設定 Multiplex Ratio
 118:bsp/Src/bsp_ssd1306.c ****     OLED_WriteCommand(0x3F); // 1/64 duty
 119:bsp/Src/bsp_ssd1306.c ****     OLED_WriteCommand(0xA4); // 輸出 RAM 內容 (關閉全螢幕點亮測試)
 120:bsp/Src/bsp_ssd1306.c ****     OLED_WriteCommand(0xD3); // 設定 Display Offset
 121:bsp/Src/bsp_ssd1306.c ****     OLED_WriteCommand(0x00); // 無偏移
 122:bsp/Src/bsp_ssd1306.c ****     OLED_WriteCommand(0xD5); // 設定顯示時鐘分頻比
 123:bsp/Src/bsp_ssd1306.c ****     OLED_WriteCommand(0xF0); // 預設值
 124:bsp/Src/bsp_ssd1306.c ****     OLED_WriteCommand(0xD9); // 設定 Pre-charge Period
 125:bsp/Src/bsp_ssd1306.c ****     OLED_WriteCommand(0x22); 
 126:bsp/Src/bsp_ssd1306.c ****     OLED_WriteCommand(0xDA); // 設定 COM Pins 硬體配置
 127:bsp/Src/bsp_ssd1306.c ****     OLED_WriteCommand(0x12); 
 128:bsp/Src/bsp_ssd1306.c ****     OLED_WriteCommand(0xDB); // 設定 VCOMH Deselect Level
 129:bsp/Src/bsp_ssd1306.c ****     OLED_WriteCommand(0x20); 
 130:bsp/Src/bsp_ssd1306.c ****     OLED_WriteCommand(0x8D); // 開啟內部電荷幫浦 (Charge Pump)
 131:bsp/Src/bsp_ssd1306.c ****     OLED_WriteCommand(0x14); // 必須開啟才能亮
 132:bsp/Src/bsp_ssd1306.c ****     OLED_WriteCommand(0xAF); // 喚醒螢幕 (Display ON)
 133:bsp/Src/bsp_ssd1306.c ****     
 134:bsp/Src/bsp_ssd1306.c ****     OLED_Clear(); // 初始化完畢後清空螢幕亂碼
 135:bsp/Src/bsp_ssd1306.c **** }
