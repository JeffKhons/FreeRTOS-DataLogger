 360:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****         ucOriginalPriority = *pucFirstUserPriorityRegister;
 361:FreeRTOS/portable/GCC/ARM_CM4F/port.c **** 
 362:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****         /* Determine the number of priority bits available.  First write to all
 363:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****          * possible bits. */
 364:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****         *pucFirstUserPriorityRegister = portMAX_8_BIT_VALUE;
