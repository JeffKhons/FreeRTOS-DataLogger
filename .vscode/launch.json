{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "STM32 Debug (OpenOCD)",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/STM32_1.elf", // 這是未來 Makefile 產出的路徑
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "device": "STM32F446RE",
            "configFiles": [
                "interface/stlink.cfg",       // 指定使用 ST-Link
                "target/stm32f4x.cfg"         // 指定目標晶片為 F4 系列
            ],
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none"
        }
    ]
}