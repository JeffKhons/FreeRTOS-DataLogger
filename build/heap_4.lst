  98:FreeRTOS/portable/MemMang/heap_4.c **** /* Define the linked list structure.  This is used to link free blocks in order
  99:FreeRTOS/portable/MemMang/heap_4.c ****  * of their memory address. */
 100:FreeRTOS/portable/MemMang/heap_4.c **** typedef struct A_BLOCK_LINK
 101:FreeRTOS/portable/MemMang/heap_4.c **** {
 102:FreeRTOS/portable/MemMang/heap_4.c ****     struct A_BLOCK_LINK * pxNextFreeBlock; /**< The next free block in the list. */
 103:FreeRTOS/portable/MemMang/heap_4.c ****     size_t xBlockSize;                     /**< The size of the free block. */
 104:FreeRTOS/portable/MemMang/heap_4.c **** } BlockLink_t;
