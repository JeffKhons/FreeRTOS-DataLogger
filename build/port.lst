 393:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****         if( ulImplementedPrioBits == 8 )
 394:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****         {
 395:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****             /* When the hardware implements 8 priority bits, there is no way for
 396:FreeRTOS/portable/GCC/ARM_CM4F/port.c ****              * the software to configure PRIGROUP to not have sub-priorities. As
